{
  "schemaVersion": 1,
  "id": "halisoncode-gametest",
  "version": "0.0.0",
  "name": "Halison Code GameTests",
  "description": "Server and client GameTests for Halison Code. Not shipped in the mod jar.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": ["halisoncode.gametest.RobotGameTests", "halisoncode.gametest.RelayGameTests", "halisoncode.gametest.RobotPerformanceGameTests",
      "halisoncode.gametest.MultiRobotGameTests", "halisoncode.gametest.SavedRobotGameTests"],
    "fabric-client-gametest": ["halisoncode.gametest.RobotClientGameTest", "halisoncode.gametest.EditorEndToEndClientGameTest",
      "halisoncode.gametest.EditorPortClientGameTest"],
    "client": ["halisoncode.gametest.FabricClientSmoke"]
  },
  "mixins": ["halisoncode-gametest.mixins.json"],
  "depends": {
    "halisoncode": "*",
    "fabric-gametest-api-v1": "*"
  }
}
