{
  "schemaVersion": 1,
  "id": "halisoncode",
  "version": "${version}",
  "name": "Halison Code",
  "description": "Program Kintro, a robot, with blocks, JavaScript or Python. Not approved by or associated with Mojang or Microsoft.",
  "authors": ["Tor Einar Enne"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/halisonworks/mod-codeling",
    "sources": "https://github.com/halisonworks/mod-codeling",
    "issues": "https://github.com/halisonworks/mod-codeling/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["halisoncode.fabric.HalisonCodeFabric"],
    "client": ["halisoncode.fabric.client.HalisonCodeFabricClient"]
  },
  "mixins": [
    "halisoncode-common.mixins.json",
    { "config": "halisoncode.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
